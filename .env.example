# ── Supabase (Realtime + Postgres) ───────────────────────────────────
# Project URL and anon key from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Google Maps ──────────────────────────────────────────────────────
# Maps JavaScript API key (restrict by HTTP referrer in production).
# Enable: Maps JavaScript API + Directions API + Geometry library.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Optional: Google Maps Map ID for Advanced Markers + cloud styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Public base URL used for generating share links / QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Security mode ─────────────────────────────────────────────────────
# false (default): direct DB writes under permissive RLS (schema.sql) — fastest
#                  way to run locally.
# true:  route privileged writes through Edge Functions + ownership RPCs.
#        Requires: run supabase/hardened.sql AND deploy the Edge Functions.
NEXT_PUBLIC_SECURE_MODE=false

# ── Edge Functions secrets (set in Supabase, NOT in the browser bundle) ──
# `supabase secrets set` — these are read only inside the Deno functions.
#   SUPABASE_URL                = (auto-provided in the functions runtime)
#   SUPABASE_SERVICE_ROLE_KEY   = service_role key from Project Settings → API
#   ALLOWED_ORIGIN              = https://your-domain.com   (CORS; '*' for dev)
